# RavenDB connection settings.
# See README.md -> "Get a RavenDB Cloud instance" for how to obtain these values.

# Comma-separated list of your RavenDB Cloud cluster node URLs (usually just one).
# Example: https://a.free.ravendb.cloud
RAVEN_URLS=

# The database name to connect to. Use "Northwind" after enabling the sample
# dataset from RavenDB Studio (Settings -> Create Sample Data).
RAVEN_DATABASE=Northwind

# RavenDB Cloud instances are secured by default and require a client
# certificate. Download the .pfx certificate from the RavenDB Cloud portal
# (Instance -> Security -> Client Certificates), then base64-encode it:
#   macOS/Linux: base64 -i your-cert.pfx | tr -d '\n'
#   Windows PS:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("your-cert.pfx"))
# Paste the resulting single-line string below. Leave both empty only for an
# unsecured local RavenDB instance (http://...).
RAVEN_CERTIFICATE_BASE64=
RAVEN_CERTIFICATE_PASSWORD=
